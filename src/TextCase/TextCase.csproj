<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>TextCase</AssemblyName>
    <RootNamespace>TextCase</RootNamespace>
    <ApplicationIcon>Assets\TextCase.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>TextCase</Product>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
    <!-- Application.ThemeMode (Windows 11 Fluent theme) is still marked experimental in WPF .NET 10. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>

    <!-- The app waits in the notification area all day: as light as it can be. No background GC thread (the heap is
         small), and code compiled ahead of time. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <!-- The Microsoft Store version (scripts\build-store.ps1, -p:StoreBuild=true): the Windows 10 2004 SDK projection
       gives the startup task of its package (Services\AppPackage.cs). Not in the GitHub version, which has no use for
       it (some 25 MB). -->
  <PropertyGroup Condition="'$(StoreBuild)' == 'true'">
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <DefineConstants>$(DefineConstants);STORE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\TextCase.ico" />
    <Resource Include="Assets\TextCase.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF projects do not import System.IO implicitly. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TextCase.Core\TextCase.Core.csproj" />
  </ItemGroup>

</Project>
